---
import { css } from 'styled-system/css';
import BaseLayout from '../layouts/BaseLayout.astro';

const prose = css({
  '& p': { mt: '4', color: 'fg' },
  '& h2': { fontSize: 'xl', fontWeight: 'semibold', mt: '10' },
  '& ul': { mt: '3', pl: '5', listStyleType: 'disc' },
  '& li': { mt: '1' },
});
---

<BaseLayout title="About" description="About Dan Levy, Software Engineer.">
  <h1 class={css({ fontSize: '3xl', fontWeight: 'bold', letterSpacing: '-0.02em' })}>About</h1>
  <div class={prose}>
    <p>
      Placeholder bio. Write a short paragraph about who you are, what you work on, and what you're
      looking for next.
    </p>

    <h2>Experience</h2>
    <ul>
      <li>Role, Company (Year–Present)</li>
      <li>Role, Company (Year–Year)</li>
    </ul>

    <h2>Skills</h2>
    <ul>
      <li>Languages: TypeScript, …</li>
      <li>Frontend: React, Astro, …</li>
      <li>Backend &amp; infrastructure: …</li>
    </ul>
  </div>
</BaseLayout>
